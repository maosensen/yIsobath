{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "yDesktopTemplate",
	"version": "0.2.0",
	"identifier": "com.maosensen.ydesktoptemplate",
	"build": {
		"beforeDevCommand": "pnpm dev",
		"devUrl": "http://localhost:4383",
		"beforeBuildCommand": "pnpm build",
		"frontendDist": "../dist"
	},
	"app": {
		"macOSPrivateApi": true,
		"windows": [
			{
				"label": "main",
				"title": "yDesktopTemplate",
				"width": 1100,
				"height": 720,
				"minWidth": 720,
				"minHeight": 480,
				"resizable": true,
				"visible": false,
				"transparent": true,
				"titleBarStyle": "Overlay",
				"hiddenTitle": true,
				"windowEffects": {
					"effects": ["sidebar", "mica", "acrylic", "blur"],
					"state": "followsWindowActiveState"
				}
			}
		],
		"security": {
			"csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://localhost:4384 http://localhost:4383"
		}
	},
	"plugins": {
		"updater": {
			"pubkey": "REPLACE_WITH_YOUR_UPDATER_PUBKEY",
			"endpoints": [
				"https://github.com/OWNER/REPO/releases/latest/download/latest.json"
			]
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"createUpdaterArtifacts": false,
		"category": "Productivity",
		"copyright": "© 2026 maosensen",
		"shortDescription": "Tauri 2 + React desktop app template.",
		"longDescription": "yDesktopTemplate is a production-shaped Tauri 2 + React desktop app template, carrying the yAssets shell baseline.",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
