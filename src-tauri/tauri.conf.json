{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "yIsobath",
	"version": "0.1.1",
	"identifier": "com.maosensen.yisobath",
	"build": {
		"beforeDevCommand": "pnpm dev",
		"devUrl": "http://localhost:4377",
		"beforeBuildCommand": "pnpm build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "yIsobath",
				"width": 1440,
				"height": 900,
				"minWidth": 1080,
				"minHeight": 680,
				"resizable": true,
				"visible": false,
				"theme": "Dark",
				"backgroundColor": "#04070a",
				"titleBarStyle": "Overlay",
				"hiddenTitle": true,
				"trafficLightPosition": { "x": 20, "y": 24 }
			}
		],
		"security": {
			"csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://localhost:4378 http://localhost:4377"
		}
	},
	"plugins": {
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg5Q0E1MUU1RkEwMEQ0MUEKUldRYTFBRDY1VkhLaWU3Um53UGV4WkVLTWhmdy9jTFIrelBVaEVUNlU1NzNmTjdKTTlTd1NSRysK",
			"endpoints": [
				"https://github.com/maosensen/yIsobath/releases/latest/download/latest.json"
			]
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"createUpdaterArtifacts": true,
		"category": "Utility",
		"copyright": "© 2026 maosensen",
		"shortDescription": "A disk survey instrument.",
		"longDescription": "yIsobath surveys a disk or a folder and draws it as a stepped relief: one terrace per folder level, an arc per byte, with lenses for file type, age and reclaimable space.",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
