{
	// Vite / Vitest config files — checked standalone by `pnpm typecheck`
	// (`tsc -p tsconfig.node.json`), so they get Node types without leaking
	// them into the WebView code under tsconfig.json.
	"compilerOptions": {
		"noEmit": true,
		"skipLibCheck": true,
		"module": "ESNext",
		"moduleResolution": "bundler",
		"types": ["node"],
		"strict": true
	},
	"include": ["vite.config.ts", "vitest.config.ts"]
}
