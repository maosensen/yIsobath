{
	"name": "yisobath",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"packageManager": "pnpm@10.33.4",
	"scripts": {
		"dev": "vite",
		"build": "tsc && vite build",
		"preview": "vite preview",
		"tauri": "tauri",
		"typecheck": "tsc --noEmit && tsc -p tsconfig.node.json",
		"lint": "biome check",
		"format": "biome check --write",
		"test": "vitest run",
		"test:watch": "vitest",
		"rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml",
		"rust:fmt:check": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
		"rust:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings",
		"rust:test": "cargo test --manifest-path src-tauri/Cargo.toml",
		"check:bindings": "cargo test --manifest-path src-tauri/Cargo.toml export_bindings && git diff --exit-code src/lib/bindings.ts",
		"check": "pnpm typecheck && pnpm lint && pnpm test && pnpm check:bindings && pnpm rust:fmt:check && pnpm rust:clippy"
	},
	"dependencies": {
		"@base-ui/react": "^1.8.0",
		"@fontsource-variable/azeret-mono": "^5.3.0",
		"@fontsource-variable/outfit": "^5.3.0",
		"@fontsource-variable/saira": "^5.3.0",
		"@hookform/resolvers": "^5.9.1",
		"@shadcn/react": "^0.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/react-query": "^5.104.0",
		"@tanstack/react-router": "^1.170.41",
		"@tanstack/react-virtual": "^3.14.13",
		"@tauri-apps/api": "^2.12.1",
		"@tauri-apps/plugin-dialog": "~2.8.1",
		"@tauri-apps/plugin-fs": "~2.6.0",
		"@tauri-apps/plugin-log": "~2.10.0",
		"@tauri-apps/plugin-opener": "^2.7.0",
		"@tauri-apps/plugin-process": "^2.4.0",
		"@tauri-apps/plugin-store": "~2.5.0",
		"@tauri-apps/plugin-updater": "^2.13.1",
		"@tauri-apps/plugin-window-state": "~2.5.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"date-fns": "^4.4.0",
		"embla-carousel-react": "^8.6.0",
		"input-otp": "^1.5.0",
		"lucide-react": "^1.49.0",
		"motion": "^13.4.6",
		"nanoid": "^6.0.1",
		"pino": "^10.3.1",
		"react": "^19.3.0",
		"react-day-picker": "^10.0.2",
		"react-dom": "^19.3.0",
		"react-hook-form": "^7.89.0",
		"react-resizable-panels": "^4.14.1",
		"recharts": "3.10.1",
		"shadcn": "^4.21.0",
		"sonner": "^2.0.8",
		"tailwind-merge": "^3.7.0",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"vaul": "^1.1.2",
		"zod": "^4.6.5",
		"zustand": "^5.0.15"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@iconify-json/solar": "^1.2.13",
		"@svgr/core": "^8.1.0",
		"@svgr/plugin-jsx": "^8.1.0",
		"@tanstack/router-plugin": "^1.168.42",
		"@tauri-apps/cli": "^2.12.1",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@types/node": "^26.6.3",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.1",
		"jsdom": "^30.1.1",
		"lefthook": "^2.1.15",
		"typescript": "~7.0.2",
		"unplugin-icons": "^24.0.0",
		"vite": "^8.3.1",
		"vitest": "^5.0.3"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"lefthook"
		]
	}
}
